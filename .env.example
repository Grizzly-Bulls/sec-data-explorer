GRIZZLY_BULLS_API_KEY=your_key_here
# Optional override for local testing. Keep this server-only.
# GRIZZLY_BULLS_SEC_API_BASE_URL=https://grizzlybulls.com/api/v1/sec

# Hosted-demo deployments use a dedicated first-party credential instead of
# GRIZZLY_BULLS_API_KEY. Keep both values server-only.
# GRIZZLY_BULLS_SEC_DEMO_ENABLED=true
# GRIZZLY_BULLS_SEC_DEMO_API_KEY=dedicated_demo_key_here
# GRIZZLY_BULLS_SEC_DEMO_REVISION=git_commit_sha
